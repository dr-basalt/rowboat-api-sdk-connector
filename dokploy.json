{
  "name": "rowboat-api-connector",
  "type": "docker",
  "sourceProvider": "github",
  "dockerfile": "Dockerfile",
  "port": 8000,
  "env": [
    {
      "key": "DEBUG",
      "value": "false"
    },
    {
      "key": "ENABLE_OWUI",
      "value": "true"
    }
  ],
  "healthcheck": {
    "path": "/health",
    "interval": 30,
    "timeout": 10,
    "retries": 3
  },
  "note": "Rowboat credentials (HOST, API_KEY, PROJECT_ID) are provided per-request, not configured at deployment."
}
